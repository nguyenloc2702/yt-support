# video-system env — copy sang .env và điền. KHÔNG commit .env.

# Data directory (SQLite + object files). Backup .sqlite3 KÈM -wal cùng lúc.
VIDEO_DATA_DIR=data

# API keys, format: key:scope (scope = read|ingest|admin), phân tách bởi dấu phẩy.
# BẮT BUỘC set trước khi expose API ngoài localhost.
# Unset: chỉ localhost được gọi (local-dev), log cảnh báo lúc startup.
VIDEO_API_KEYS=devkey-admin:admin,devkey-ingest:ingest,devkey-read:read

# Webhook signing secret (HMAC-SHA256). Unset = webhook không dispatch.
VIDEO_WEBHOOK_SECRET=

# Allowlist host cho URL fetch (audio import, keyframe import), phân tách phẩy.
VIDEO_ALLOWED_HOSTS=drive.google.com,storage.googleapis.com,localhost

# --- Short Studio (Phụ lục G) ---
# xKiro gateway (LLM viết kịch bản + ảnh dọc). Unset = adapter fail-closed,
# API /shorts trả 503 tiếng người (không crash).
VIDEO_XKIRO_API_KEY=
VIDEO_XKIRO_BASE_URL=https://api.xkiro.com/v1
VIDEO_XKIRO_LLM_MODEL=mistralai/mistral-large-4-0
VIDEO_XKIRO_LLM_FALLBACK_MODELS=qwen/qwen3.8-omni-flash:free
VIDEO_XKIRO_IMAGE_MODEL=openai/gpt-image-2.5

# Hộp tin nóng (G.10): bật scheduler sync RSS + push Telegram mỗi interval_min phút.
VIDEO_NEWS_SYNC_ENABLED=0
VIDEO_TELEGRAM_BOT_TOKEN=
VIDEO_TELEGRAM_CHAT_ID=
