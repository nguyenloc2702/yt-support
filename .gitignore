.env
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/

# Runtime data and large media
/data/*
!/data/.gitkeep
/projects/*
!/projects/.gitkeep
/logs/*
!/logs/.gitkeep
*.sqlite3
*.mp4
*.mov
*.mkv
*.webm
*.m4v
*.wav
*.mp3
*.flac
*.aac
*.ogg
*.opus
*.m4a

# Local model/cache directories
.huggingface/
.cache/

# Temporary test scripts and diagnostics
scripts_tmp_*.py
pw_out/
temp_tts_*/
temp_*/
scratch/
*.words.json

# Account sessions and pool state (CRITICAL SECURITY: never commit cookies)
/sessions/*
!/sessions/.gitkeep

